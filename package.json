{
  "name": "church-tech-checklist",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:e2e:quick": "playwright test --project=phone --retries=0",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.39.3",
    "jose": "^6.0.8",
    "next": "^15.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.2.1",
    "pg-mem": "^3.0.14",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
